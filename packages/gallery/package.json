{
  "name": "@ziee/gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:node": "node ../../scripts/run-node-tests.mjs --min 7",
    "test": "npm run typecheck && vitest run && npm run test:node"
  },
  "exports": {
    ".": "./src/index.ts",
