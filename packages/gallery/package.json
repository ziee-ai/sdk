    "./vite/*": "./vite/*",
    "./playwright/*": "./playwright/*",
    "./*": "./src/*"
  },
  "bin": {
    "ziee-gallery": "scripts/cli.mjs"
  },
  "peerDependencies": {
    "@ziee/framework": "*",
    "@ziee/kit": "*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
